{
    "name": "code-viewer",
    "version": "1.0.4",
    "description": "View and edit source code files with native syntax highlighting.",
    "author": "Kevin",
    "license": "MIT",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/TracingOrigins/obsidian-code-viewer-plugin.git"
    },
    "main": "main.js",
    "type": "module",
    "scripts": {
        "dev": "node scripts/deploy.mjs dev && node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node scripts/deploy.mjs build",
        "version": "node version-bump.mjs && git add package.json manifest.json versions.json",
        "lint": "eslint ."
    },
    "config": {
        "tag-version-prefix": ""
    },
    "keywords": [
        "Code",
        "Code Viewer",
        "Obsidian Plugin"
    ],
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/node": "^26.1.2",
        "@typescript-eslint/parser": "^8.59.1",
        "esbuild": "^0.28.1",
        "eslint": "^9.39.4",
        "eslint-plugin-obsidianmd": "^0.4.0",
        "globals": "^17.6.0",
        "obsidian": "latest",
        "tsx": "^4.23.5",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.59.1"
    }
}
